{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magnit.tech/opencode/installers/manifest.schema.json",
  "title": "opencode-magnit package manifest",
  "description": "Единственный источник правды о содержимом пакета (installers/docs/spec.md, N5-P3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "version",
    "os",
    "arch",
    "built_at",
    "source_release",
    "ca",
    "artifacts",
    "purge_paths"
  ],
  "anyOf": [
    {
      "description": "Адрес корпоративной точки входа: Hub, каталог коннекторов или оба. Ревизия 1.10 (S-C10): прямая авторизация без Hub делает hub_url необязательным, но пакет без единого адреса бесполезен — установщику нечего печатать в отчёте, а клиенту некуда идти за каталогом.",
      "required": ["hub_url"]
    },
    { "required": ["catalog_url"] }
  ],
  "properties": {
    "schema": {
      "description": "Версия схемы манифеста; для I-5 ровно 1.",
      "const": 1
    },
    "product": {
      "description": "Имя продукта.",
      "const": "opencode-magnit"
    },
    "version": {
      "description": "Версия сборки в формате <upstream>-magnit.<N> (S-B1).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-magnit\\.[0-9]+$"
    },
    "os": {
      "type": "string",
      "enum": ["darwin", "linux", "windows"]
    },
    "arch": {
      "type": "string",
      "enum": ["arm64", "x64"]
    },
    "hub_url": {
      "description": "Адрес Hub; печатается в отчёте и в --check, установщиком никуда не записывается. Ревизия 1.10 (S-C10): необязателен — сборка может идти на прямую авторизацию с каталогом коннекторов вместо Hub.",
      "type": "string",
      "minLength": 1
    },
    "catalog_url": {
      "description": "Адрес статического каталога коннекторов (S-C10); печатается в отчёте и в --check, установщиком никуда не записывается. Задаётся вместо hub_url или вместе с ним.",
      "type": "string",
      "minLength": 1
    },
    "signed": {
      "description": "Подписана ли сборка Desktop (S-B17). false — установщик снимает карантин Gatekeeper после копирования бандла: неподписанное приложение на macOS 15+ иначе не запускается вовсе («повреждено»). При появлении сертификатов сюда пишется true, и шаг снятия карантина гаснет сам. Поле отсутствует = false: пакеты, собранные до ревизии 1.10, тоже неподписаны.",
      "type": "boolean"
    },
    "built_at": {
      "description": "Момент сборки пакета, ISO-8601 UTC.",
      "type": "string",
      "minLength": 1
    },
    "source_release": {
      "description": "Тег релиза форка, из которого взяты артефакты (S-B4).",
      "type": "string",
      "minLength": 1
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "install_name"],
      "properties": {
        "file": { "$ref": "#/definitions/pkgPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "install_name": { "$ref": "#/definitions/pkgPath" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact" },
      "allOf": [
        {
          "description": "Ровно один артефакт kind=\"cli\".",
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "cli" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "description": "Не более одного артефакта kind=\"desktop\".",
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "desktop" } },
            "required": ["kind"]
          },
          "maxContains": 1
        }
      ]
    },
    "purge_paths": {
      "description": "Пути, удаляемые при --purge (N5-R2). Допустимы подстановки ~, ${XDG_CONFIG_HOME}, ${XDG_DATA_HOME}, %USERPROFILE%, %LOCALAPPDATA%.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "sha256": {
      "description": "Ровно 64 символа [0-9a-f]; сравнение регистронезависимое.",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "pkgPath": {
      "description": "Путь относительно корня пакета: разделитель /, без ведущего /, без сегментов . и .. и без букв дисков. Ревизия 1.5 (N5-P4, N5-I13): набор символов задан белым списком A-Za-z0-9._- плюс / как разделитель и пробел (не ведущий и не завершающий, нужен для app_name вида «OpenCode Magnit.app»). Схема — вторая линия защиты: значения этих полей попадают в генерируемый код файла профиля, поэтому метасимвол оболочки делает манифест невалидным. Установщик проверяет те же поля строже: пробел он допускает только в app_name.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\n\\r])(?!/)(?!.*/$)(?!(?:.*/)?\\.\\.?(?:/|$))(?! )(?!.* $)(?!.*//)[A-Za-z0-9._ /-]+$"
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "file", "sha256"],
      "properties": {
        "kind": { "type": "string", "enum": ["cli", "desktop"] },
        "file": { "$ref": "#/definitions/pkgPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "url": {
          "description": "Справочное поле: установщик его никогда не запрашивает (N5-P6).",
          "type": "string"
        },
        "install_name": { "$ref": "#/definitions/pkgPath" },
        "installer_type": { "type": "string", "enum": ["dmg", "nsis", "msi"] },
        "app_name": { "$ref": "#/definitions/pkgPath" },
        "silent_args": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "CLI-артефакт обязан содержать install_name.",
          "if": {
            "properties": { "kind": { "const": "cli" } },
            "required": ["kind"]
          },
          "then": { "required": ["install_name"] }
        },
        {
          "description": "Desktop-артефакт обязан содержать installer_type.",
          "if": {
            "properties": { "kind": { "const": "desktop" } },
            "required": ["kind"]
          },
          "then": { "required": ["installer_type"] }
        },
        {
          "description": "Для dmg обязательно app_name.",
          "if": {
            "properties": { "installer_type": { "const": "dmg" } },
            "required": ["installer_type"]
          },
          "then": { "required": ["app_name"] }
        }
      ]
    }
  }
}
