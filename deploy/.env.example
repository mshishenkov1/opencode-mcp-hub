# Скопировать в deploy/.env и заполнить. В репозиторий .env не попадает.
HUB_PUBLIC_URL=https://localhost:8443
HUB_REPLICAS=2
POSTGRES_PASSWORD=change-me
HUB_SECRET_KEY=change-me-32-bytes-base64          # подпись JWT Hub
HUB_ENCRYPTION_KEY=change-me-32-bytes-base64      # шифрование токенов систем (AES-GCM)

# LiteLLM (вход и ключ модели)
HUB_LITELLM_BASE_URL=https://llmlite.ailab-copilot-prod.corp.tander.ru
HUB_LITELLM_MODEL=MagnitCopilot
HUB_LOG_LEVEL=INFO
# HUB_ADMIN_TOKEN=            # включает POST /admin/catalog/reload

# Keycloak (веб-интерфейс Hub)
KEYCLOAK_ISSUER=https://hi.tander.ru/auth/realms/Tander-SSO
KEYCLOAK_CLIENT_ID=opencode-mcp-hub
KEYCLOAK_CLIENT_SECRET=

# OAuth-приложения систем (заполняются, когда выдадут администраторы)
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_PLATFORM_OAUTH_CLIENT_ID=
GITLAB_PLATFORM_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
CONFLUENCE_OAUTH_CLIENT_ID=
CONFLUENCE_OAUTH_CLIENT_SECRET=

# ТЭГ-MCP (нативный OAuth)
TAG_MCP_URL=https://localhost:8443/tag/mcp
TAG_MCP_PUBLIC_URL=https://localhost:8443/tag
MM_URL=https://tag.magnit.ru
MM_OAUTH_CLIENT_ID=
MM_OAUTH_CLIENT_SECRET=

# Корпоративный CA монтируется из deploy/ca/tander-ca-bundle.pem (см. docker-compose.yml)

# ---------------------------------------------------------------------------
# I-3: OAuth-фасад, MCP-proxy и веб-интерфейс Hub (spec.md §10, R-T1).
# Все переменные ниже необязательны — приведены значения по умолчанию.
# ---------------------------------------------------------------------------

# Веб-интерфейс и экран прав
HUB_WEB_AUTH=litellm                 # способ входа в веб: keycloak (OIDC) или litellm (CLI-SSO)
HUB_CONSENT=always                   # always — экран прав каждый раз; remember — помнить согласие
HUB_WEB_SESSION_TTL=28800            # срок жизни веб-сессии, с

# Hub как authorization server для facade-серверов
HUB_OAUTH_ALLOWED_REDIRECTS=["http://127.0.0.1:*","http://localhost:*"]  # маски redirect_uri при DCR
HUB_ACCESS_TOKEN_TTL=3600            # срок жизни access-токена Hub, с
HUB_REFRESH_TOKEN_TTL=2592000        # срок жизни refresh-токена Hub, с (30 дней)
HUB_AUTH_CODE_TTL=60                 # срок жизни кода авторизации, с
HUB_OAUTH_TX_TTL=600                 # срок жизни транзакции /oauth/authorize, с
HUB_RATE_LIMIT_REGISTER=10           # регистраций клиента в 60 с на IP
HUB_RATE_LIMIT_TOKEN=60              # обращений к /oauth/token в 60 с на (client_id, IP)

# MCP-proxy
HUB_RATE_LIMIT_MCP=120               # запросов к /mcp/{alias} в 60 с на (пользователь, alias)
HUB_MAX_SSE_PER_USER=4               # одновременных SSE-потоков на пользователя
HUB_MAX_BODY_BYTES=1048576           # максимальный размер тела запроса к /mcp/{alias}, байт
HUB_UPSTREAM_TIMEOUT=30.0            # таймаут соединения и первого байта ответа upstream, с
HUB_UPSTREAM_SSE_IDLE_TIMEOUT=300.0  # таймаут бездействия внутри SSE-потока, с
HUB_UPSTREAM_IDLE_TTL=600            # простой, после которого upstream-сессия считается закрытой, с
HUB_CLIENT_SESSION_TTL=86400         # срок жизни клиентской (виртуальной) MCP-сессии, с
HUB_TOOLS_CACHE_TTL=300              # TTL кэша tools/list, с
HUB_CB_FAILURES=5                    # порог circuit-breaker: подряд идущих ошибок upstream
HUB_CB_RESET=30                      # время «открытого» состояния circuit-breaker, с
HUB_CONNECTION_CACHE_TTL=60          # TTL кэша подключения (права, срок токена), с

# Брокер токенов целевых систем
HUB_TOKEN_REFRESH_LEAD=300           # за сколько секунд до истечения обновлять upstream-токен
HUB_TOKEN_REFRESH_INTERVAL=60        # период фоновой задачи обновления, с
HUB_TOKEN_REFRESH_ENABLED=true       # включение фоновой задачи обновления

# Миграции БД
HUB_DB_AUTO_MIGRATE=true             # применять миграции Alembic при старте

# OIDC Keycloak (обязательны KEYCLOAK_ISSUER и KEYCLOAK_CLIENT_SECRET при HUB_WEB_AUTH=keycloak)
# KEYCLOAK_ISSUER=                   # задан выше, в блоке Keycloak
# KEYCLOAK_CLIENT_ID=opencode-mcp-hub
# KEYCLOAK_CLIENT_SECRET=            # секрет OIDC-клиента, оставить пустым в примере
KEYCLOAK_SCOPES=openid profile email # запрашиваемые scope OIDC
KEYCLOAK_JWKS_TTL=3600               # TTL кэша JWKS/метаданных issuer'а, с
