# Скопировать в deploy/.env и заполнить. В репозиторий .env не попадает.
HUB_PUBLIC_URL=https://localhost:8443
HUB_REPLICAS=2
POSTGRES_PASSWORD=change-me
HUB_SECRET_KEY=change-me-32-bytes-base64          # подпись JWT Hub
HUB_ENCRYPTION_KEY=change-me-32-bytes-base64      # шифрование токенов систем (AES-GCM)

# LiteLLM (вход и ключ модели)
LITELLM_BASE_URL=https://llmlite.ailab-copilot-prod.corp.tander.ru
LITELLM_MODEL=MagnitCopilot

# Keycloak (веб-интерфейс Hub)
KEYCLOAK_ISSUER=https://hi.tander.ru/auth/realms/Tander-SSO
KEYCLOAK_CLIENT_ID=opencode-mcp-hub
KEYCLOAK_CLIENT_SECRET=

# OAuth-приложения систем (заполняются, когда выдадут администраторы)
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_PLATFORM_OAUTH_CLIENT_ID=
GITLAB_PLATFORM_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
CONFLUENCE_OAUTH_CLIENT_ID=
CONFLUENCE_OAUTH_CLIENT_SECRET=

# ТЭГ-MCP (нативный OAuth)
TAG_MCP_URL=https://localhost:8443/tag/mcp
TAG_MCP_PUBLIC_URL=https://localhost:8443/tag
MM_URL=https://tag.magnit.ru
MM_OAUTH_CLIENT_ID=
MM_OAUTH_CLIENT_SECRET=

# Корпоративный CA для исходящих запросов из контейнеров
SSL_CERT_FILE=/etc/ssl/certs/tander-ca-bundle.pem
