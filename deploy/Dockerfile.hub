FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install ".[postgres]"
COPY catalog.yaml ./catalog.yaml
# Словари групп разрешений (R-C7.5): подхватываются load_catalog из каталога рядом
COPY permissions ./permissions
RUN useradd -r -u 10001 hub && chown -R hub /app
USER hub
EXPOSE 8000
CMD ["uvicorn", "hub.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
